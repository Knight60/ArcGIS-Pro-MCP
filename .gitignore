dist/*.tar.gz

# C# add-in build output
addin/**/bin/
addin/**/obj/

# C# test project build output
tests/**/bin/
tests/**/obj/
scripts/**/bin/
scripts/**/obj/

# Backups this project's own tooling writes
*.arcgis-mcp.bak
*.arcgis-mcp.bak.*
http-token.txt

# Private credentials, diagnostics, and local GIS datasets are never source assets.
.env
.env.*
*.pfx
*.p12
*.key
*.pem
*.log
*.dmp
*.aprx
*.gdb/

# Historical tracked binaries/images still exist locally; the publication
# exporter excludes them regardless of Git tracking. Do not push this checkout
