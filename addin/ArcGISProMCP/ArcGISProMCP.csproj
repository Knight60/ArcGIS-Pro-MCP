<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ArcGIS Pro MCP add-in.

    Assemblies are referenced straight out of the ArcGIS Pro installation, so
    the only thing this needs beyond Pro itself is the .NET 8 SDK: no NuGet
    feed and no Visual Studio extension.

    Packaging is left to Esri's own targets file, which ships with Pro: it
    builds the .esriAddinX with the layout Pro expects and then registers it
    with RegisterAddIn.exe, so a build installs the add-in ready for the next
    ArcGIS Pro start.
  -->

  <PropertyGroup>
    <!--
      Must match the framework ArcGIS Pro itself targets: its assemblies are
      built against it, and referencing an assembly from a newer framework is
      a compile error. Pro 3.7 is net10.0; 3.3-3.6 were net8.0. Check
      the bin/ArcGISPro.runtimeconfig.json in the Pro install after an upgrade, or
      override with -p:TargetFramework=net8.0-windows to build for an older Pro.
    -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- Both are checked against Config.daml by Esri's packaging task. -->
    <AssemblyName>ArcGISProMCP</AssemblyName>
    <RootNamespace>ArcGISProMCP</RootNamespace>

    <PackageType>addin</PackageType>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <Company>ArcGIS Pro MCP</Company>
    <Product>ArcGIS Pro MCP</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Where ArcGIS Pro is installed. Override with -p:ArcGISProDir=... -->
  <PropertyGroup>
    <ArcGISProDir Condition="'$(ArcGISProDir)' == ''">$(ProgramW6432)\ArcGIS\Pro</ArcGISProDir>
    <ArcGISProBin>$(ArcGISProDir)\bin</ArcGISProBin>
  </PropertyGroup>

  <!--
    Ribbon icons. Resource, not Content: they are read through pack:// URIs
    from inside the assembly, so the .esriAddinX stays a single file.
    Regenerate them with scripts/make_icons.ps1.
  -->
  <ItemGroup>
    <Resource Include="Images\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ArcGIS.Core">
      <HintPath>$(ArcGISProBin)\ArcGIS.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Framework">
      <HintPath>$(ArcGISProBin)\ArcGIS.Desktop.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Core">
      <HintPath>$(ArcGISProBin)\Extensions\Core\ArcGIS.Desktop.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Mapping">
      <HintPath>$(ArcGISProBin)\Extensions\Mapping\ArcGIS.Desktop.Mapping.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Editing">
      <HintPath>$(ArcGISProBin)\Extensions\Editing\ArcGIS.Desktop.Editing.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Layouts">
      <HintPath>$(ArcGISProBin)\Extensions\Layout\ArcGIS.Desktop.Layouts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Catalog">
      <HintPath>$(ArcGISProBin)\Extensions\Catalog\ArcGIS.Desktop.Catalog.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Content, not None: Esri's packaging task copies @(Content) into the root
    of the .esriAddinX, and only when it is not also copied to the output
    directory. Config.daml must land at the archive root.
  -->
  <ItemGroup>
    <Content Include="Config.daml" />
    <!--
      Geoprocessing parameter names and their order, captured from arcpy by
      scripts/dump_gp_parameters.py. ArcGIS Pro's API runs tools positionally
      and cannot report parameter names, so this is what lets the add-in take
      named parameters. Regenerate it when targeting a new ArcGIS Pro release.
    -->
    <EmbeddedResource Include="Resources\gp-parameters.json"
                      Condition="Exists('Resources\gp-parameters.json')" />
    <!--
      MCP tool schemas, exported from catalog.py by
      scripts/export_tool_schemas.py so the add-in serves the same tools the
      Python server does rather than defining them a second time.
    -->
    <EmbeddedResource Include="Resources\tools.json"
                      Condition="Exists('Resources\tools.json')" />
  </ItemGroup>

  <!--
    Packaging.

    Esri ships Esri.ProApp.SDK.Desktop.targets with ArcGIS Pro, but it builds
    its tasks with CodeTaskFactory, which only the .NET Framework MSBuild that
    comes with Visual Studio supports; `dotnet build` fails on it. The layout
    it produces is simple enough to reproduce here, so the add-in builds the
    same way from either MSBuild:

      <name>.esriAddinX
        Config.daml          at the root
        Install\<name>.dll    the assemblies

    RegisterAddIn.exe then installs it for the current user, which is what
    makes the add-in available the next time ArcGIS Pro starts.
  -->
  <Target Name="PackageAddIn" AfterTargets="Build">
    <PropertyGroup>
      <AddInStage>$(IntermediateOutputPath)addin-stage\</AddInStage>
      <AddInFile>$(OutputPath)$(AssemblyName).esriAddinX</AddInFile>
    </PropertyGroup>

    <RemoveDir Directories="$(AddInStage)" />
    <MakeDir Directories="$(AddInStage)Install" />

    <Copy SourceFiles="Config.daml" DestinationFolder="$(AddInStage)" />
    <ItemGroup>
      <AddInBinaries Include="$(OutputPath)$(AssemblyName).dll" />
      <!-- The dll and its symbols only: a deps.json here makes Pro's loader
           try to resolve dependencies it already provides. -->
      <AddInBinaries Include="$(OutputPath)$(AssemblyName).pdb" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(AddInBinaries)" DestinationFolder="$(AddInStage)Install" />

    <Delete Files="$(AddInFile)" />
    <ZipDirectory SourceDirectory="$(AddInStage)" DestinationFile="$(AddInFile)" />
    <Message Importance="high" Text="Add-in packaged: $(AddInFile)" />

    <!--
      Deploy by dropping the package in the folder ArcGIS Pro scans at
      startup. RegisterAddIn.exe does the same job but returns nothing useful
      when it fails, and this is easy to verify.
    -->
    <PropertyGroup>
      <!--
        The real Documents folder, not %USERPROFILE%\Documents: it is often
        redirected (OneDrive), and ArcGIS Pro only scans the redirected one.
      -->
      <AddInDeployFolder Condition="'$(AddInDeployFolder)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\ArcGIS\AddIns\ArcGISPro</AddInDeployFolder>
    </PropertyGroup>
    <MakeDir Directories="$(AddInDeployFolder)" Condition="'$(DeployAddIn)' != 'false'" />
    <Copy SourceFiles="$(AddInFile)" DestinationFolder="$(AddInDeployFolder)"
          Condition="'$(DeployAddIn)' != 'false'" />
    <Message Importance="high" Condition="'$(DeployAddIn)' != 'false'"
             Text="Deployed to $(AddInDeployFolder). Restart ArcGIS Pro to load it." />
  </Target>

</Project>
