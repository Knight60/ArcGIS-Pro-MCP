root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csproj,daml}]
indent_size = 4

[*.{md,json,yml}]
indent_size = 2

# Trailing spaces are meaningful in Markdown line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{ps1,cmd}]
end_of_line = crlf

[*.py]
indent_size = 4
max_line_length = 100
